    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0"
  }
