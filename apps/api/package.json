{
  "name": "@money-tracker/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:migrate": "ts-node src/database/migrate.ts",
    "dev": "NODE_OPTIONS=--enable-source-maps nest start --watch",
