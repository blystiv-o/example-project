{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "API_INTERNAL_URL",
    "API_PORT",
    "LOG_FILE",
    "AUTH_ALLOWED_ORIGINS",
    "AUTH_COOKIE_NAME",
    "AUTH_COOKIE_SECURE",
    "AUTH_SESSION_TTL_SECONDS",
    "AUTH_TRUST_PROXY",
    "DATABASE_URL",
    "NODE_ENV",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
